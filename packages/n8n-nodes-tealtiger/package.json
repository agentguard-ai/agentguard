{
  "name": "n8n-nodes-tealtiger",
  "version": "0.1.0",
  "description": "TealTiger governance node for n8n",
  "keywords": [
    "n8ncommunity-node-package"
  ],
  "license": "Apache-2.0",
  "homepage": "https://tealtiger.co.in",
  "author": "TealTiger Team",
  "main": "dist/nodes/TealTiger/TealTiger.node.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/nodes/TealTiger',{recursive:true});require('fs').copyFileSync('src/nodes/TealTiger/tealtiger.svg','dist/nodes/TealTiger/tealtiger.svg')\"",
    "dev": "tsc --watch",
    "test": "echo \"No tests specified for now, planned for follow up\" && exit 0"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TealTigerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TealTiger/TealTiger.node.js"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/request-promise-native": "~1.0.15",
    "n8n-core": "^1.0.0",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "tealtiger": "^1.4.0"
  }
}
